// rr2_enc1 kernel: input merge from the enc0 TensorOutput, block (k8 path), DFN head, pooling, merge to 96 channels (see include/onr_block.glsl).
#version 460
#extension GL_GOOGLE_include_directive : require
#include "onr_common.glsl"
#define ENC_C 64
#define ENC_X 64
#define ENC_K8 1
#define ENC_STAGE 1
#define ENC_CO 96
#define ENC_MERGE_IN 1
#define ENC_CIN 32
// W2_SL=64 FP8 MLP: Mesa's full unroll of 4 fat slices bloats exec +42%; keep it rolled.
#if defined(LT_MLP8)
#define MLP_SLICE_LOOP [[dont_unroll]]
#endif
#include "onr_block.glsl"
